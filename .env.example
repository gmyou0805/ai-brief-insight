# ── 외부 공개용(Vercel + Neon) 환경변수 ──
# 로컬 개발: 이 파일을 .env 로 복사해 채우세요. Vercel 배포: 프로젝트 Settings > Environment Variables 에 동일하게 등록.

# Neon 대시보드 > Connection Details 의 연결 문자열(Pooled connection 권장).
# sslmode=require 가 반드시 포함돼야 SSL 로 접속합니다(lib/db.ts 참고).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── 로그인(Auth.js) ──
# JWT 서명용 비밀키 — 기존 서버와 다른 새 값을 쓰세요. 생성: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string
AUTH_TRUST_HOST=true

# (선택) 소셜 로그인. 비워두면 해당 버튼만 실패하고 이메일 로그인은 정상 동작.
# 리디렉션 URI: https://<vercel-도메인>/api/auth/callback/<google|kakao|microsoft-entra-id|naver>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# ── (선택) 수집 스크립트를 로컬에서 직접 돌려 Neon 에 적재할 때만 ──
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# KIPRIS_API_KEY=
